{
  "name": "live-instrument-kit",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui-svelte",
    "examples/demo"
  ],
  "scripts": {
    "dev": "npm --workspace examples/demo run dev",
    "build": "npm --workspace examples/demo run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:rust": "cargo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run test:rust"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.2.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.53.12",
    "svelte-check": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.1"
  }
}
