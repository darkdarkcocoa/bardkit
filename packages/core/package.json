{
  "name": "bardkit-core",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "description": "Framework-free in-game instrument core: notes, plucked-string synth, input batching, remote replay, BGM yield",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkdarkcocoa/bardkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/darkdarkcocoa/bardkit#readme",
  "keywords": [
    "web-audio",
    "game-audio",
    "karplus-strong",
    "procedural-audio",
    "multiplayer",
    "gamedev",
    "instrument",
    "music"
  ]
}
